{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/task.schema.json",
  "title": "Agent Delegated Task",
  "description": "A structured task contract for delegation between software agents.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "goal",
    "acceptance_criteria",
    "scope",
    "verification"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable task identifier."
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "description": "Observable outcome the task must achieve."
    },
    "context": {
      "type": "array",
      "items": { "type": "string" },
      "default": [],
      "description": "Relevant files, links, constraints, and prior decisions."
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "description": "Files or subsystems allowed to change."
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "description": "Checks expected before completion."
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "owner": {
      "type": ["string", "null"],
      "default": null
    },
    "reviewer": {
      "type": ["string", "null"],
      "default": null
    },
    "status": {
      "type": "string",
      "enum": ["proposed", "ready", "in_progress", "review", "done", "blocked"],
      "default": "proposed"
    }
  }
}
